{
    "name": "tomrichmond/garmin-personal-api",
    "description": "Framework-independent PHP client for the official Garmin Connect Personal API",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0",
        "psr/simple-cache": "^3.0",
        "nyholm/psr7": "^1.8",
        "symfony/http-client": "^7.3|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "phpstan/phpstan": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload": {"psr-4": {"TomRichmond\\GarminPersonalApi\\": "src/"}},
    "autoload-dev": {"psr-4": {"TomRichmond\\GarminPersonalApi\\Tests\\": "tests/"}},
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress --debug",
        "format:check": "php-cs-fixer fix --dry-run --diff"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
